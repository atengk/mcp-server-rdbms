# ==============================================================================
# atengk-mcp-server-rdbms 环境变量配置模板 (.env.example)
#
# 使用指南：
# 1. 复制本文件为 .env：cp .env.example .env
# 2. 根据实际数据库环境取消对应注释并填入连接信息
# 3. 运行服务时将自动感知读取本文件，本地调试零配置极速自举
# 注意：基于专属命名空间规则 (ADR-0023)，服务严格只识别 MCP_RDBMS_* 规范前缀变量
# ==============================================================================

# ------------------------------------------------------------------------------
# 模式 A：原子字段独立配置（🔥 强烈推荐：密码特殊字符免手动转义！）
# ------------------------------------------------------------------------------
# 数据库方言类型：mysql / postgresql / oracle / mssql / sqlite
MCP_RDBMS_DIALECT=mysql

# 数据库主机与端口（缺省时自动根据方言匹配标准端口，如 MySQL 3306, PG 5432）
MCP_RDBMS_DB_HOST=127.0.0.1
MCP_RDBMS_DB_PORT=3306

# 数据库登录用户名
MCP_RDBMS_USER=root

# 数据库登录密码（直接填写原始明文密码即可！包含 @, #, :, /, 空格 等特殊字符均会自动安全转义）
MCP_RDBMS_PASSWORD=Admin@123#2026

# 目标数据库 / Schema 名称
MCP_RDBMS_DATABASE=mydb

# 可选连接参数（例如编码集等）
# MCP_RDBMS_PARAMS=charset=utf8mb4

# ------------------------------------------------------------------------------
# 模式 B：全量单库连接串模式（全量 URL 优先级高于模式 A 原子字段）
# ------------------------------------------------------------------------------
# MCP_RDBMS_DB_URL=postgresql+psycopg://postgres:secret@localhost:5432/my_pg_db
# MCP_RDBMS_DB_URL=sqlite:///./workspace.db

# ------------------------------------------------------------------------------
# 模式 C：零配置文件动态多数据库模式 (Zero-Config Multi-DB)
# ------------------------------------------------------------------------------
# 方式 1：动态前缀注入 (推荐，格式: MCP_RDBMS_DB_<ALIAS>)
# MCP_RDBMS_DB_CRM=postgresql+psycopg://user:pass@10.0.0.1:5432/crm_db
# MCP_RDBMS_DB_ERP=mysql+pymysql://root:pass@10.0.0.2:3306/erp_db
# 显式指定多库环境下的默认连接别名
# MCP_RDBMS_DEFAULT_DB=crm

# 方式 2：单行逗号分隔聚合声明 (可选)
# MCP_RDBMS_DBS=crm=postgresql+psycopg://user:pass@10.0.0.1:5432/crm_db,erp=mysql+pymysql://root:pass@10.0.0.2:3306/erp_db

# ------------------------------------------------------------------------------
# 模式 D：多数据库配置文件模式（YAML 格式文件）
# ------------------------------------------------------------------------------
# MCP_RDBMS_CONFIG=/path/to/connections.yaml

# ------------------------------------------------------------------------------
# 权限与安全门禁（宽容布尔值：1 / true / yes / on / t）
# ------------------------------------------------------------------------------
# 默认均为 false（强只读模式）；若需执行增删改或表结构变更，设为 true
MCP_RDBMS_ALLOW_DML=false
MCP_RDBMS_ALLOW_DDL=false

# ------------------------------------------------------------------------------
# 服务网络与通信传输设置（支持 100% 容器化无参启动）
# ------------------------------------------------------------------------------
# 通信传输协议：stdio（命令行客户端直连，默认）/ sse / streamable-http
MCP_RDBMS_TRANSPORT=stdio

# 仅在 SSE / HTTP 远程模式下生效的监听主机与端口
MCP_RDBMS_SERVER_HOST=127.0.0.1
MCP_RDBMS_SERVER_PORT=8000

# ------------------------------------------------------------------------------
# 服务元数据自解释（多服务实例独立挂载时供大模型精准识别业务定位）
# ------------------------------------------------------------------------------
# MCP_RDBMS_SERVER_NAME=mcp-server-rdbms
# MCP_RDBMS_SERVER_INSTRUCTIONS=企业核心数据库查询通道，负责订单、用户与财务数据探查。

# ------------------------------------------------------------------------------
# 操作审计流水与防爆截断设置 (Audit Trail)
# ------------------------------------------------------------------------------
# 审计记录范围：mutation（仅变更, 默认）/ all（含只读查询与 EXPLAIN）/ off（完全关闭）
# MCP_RDBMS_AUDIT_MODE=mutation
# 审计日志落盘文件路径
# MCP_RDBMS_AUDIT_LOG_FILE=rdbms_mcp_audit.log
# 单文件触发日志切片轮转的最大字节数（默认 10MB: 10485760）
# MCP_RDBMS_AUDIT_MAX_BYTES=10485760
# 本地保留的历史审计切片日志副本数量
# MCP_RDBMS_AUDIT_BACKUP_COUNT=5
